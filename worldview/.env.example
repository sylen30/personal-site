# Flights proxy URL — required for the Flights layer on GitHub Pages / any static host.
# All public ADS-B APIs block CORS from browser origins; this worker adds the missing headers.
# Deploy: cd worldview/flights-proxy && npm i -g wrangler && wrangler login && wrangler deploy
# Set this to the worker URL shown after deploy (e.g. https://worldview-flights.user.workers.dev)
VITE_FLIGHTS_PROXY_URL=

# Cesium Ion access token — free at https://ion.cesium.com/tokens
# Required for satellite imagery basemap and terrain. Without it, the globe
# falls back to a blue-marble offline imagery layer.
VITE_CESIUM_ION_TOKEN=

# AISStream.io API key — free at https://aisstream.io/authenticate
# Required for the live Ships layer. Skip to disable that layer.
VITE_AISSTREAM_API_KEY=

# Google Map Tiles API key (optional) — enables Photorealistic 3D Tiles.
# Get one at https://developers.google.com/maps/documentation/tile/get-api-key
VITE_GOOGLE_3D_TILES_KEY=
